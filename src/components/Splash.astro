---
import { SEASONAL_ITEMS, SEASON_LABEL } from '../data/seasonal';

interface Props {
  photo?: string;  // Optional path to full-bleed atmospheric photo
}

const { photo } = Astro.props;
---

<section class={`splash${photo ? ' splash--photo' : ''}`} aria-label="Welcome" data-splash>

  <!-- Living texture: drifting warm blobs (hidden in photo mode) -->
  {!photo && (
    <>
      <div class="splash-blob splash-blob--1" aria-hidden="true"></div>
      <div class="splash-blob splash-blob--2" aria-hidden="true"></div>
      <div class="splash-blob splash-blob--3" aria-hidden="true"></div>
    </>
  )}

  <!-- Photo mode background -->
  {photo && (
    <>
      <div class="splash-photo" style={`background-image: url('${photo}')`} aria-hidden="true"></div>
      <div class="splash-photo-overlay" aria-hidden="true"></div>
    </>
  )}

  <div class="splash-content">
    <p class="eyebrow splash-eyebrow">Magnus &amp; Tessern's Recipes</p>
    <h1 class="splash-title">A kitchen, written down</h1>
    <hr class="hairline splash-rule" />
    <p class="splash-season">
      <span class="splash-season-label">{SEASON_LABEL}:</span>
      {SEASONAL_ITEMS.join(' · ')}
    </p>
  </div>

  <div class="splash-cue" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l5 5 5-5" />
    </svg>
    <p class="splash-cue-label">tap to explore</p>
  </div>
</section>

<script>
  const splash = document.querySelector('[data-splash]') as HTMLElement | null;
  if (splash) {
    if (sessionStorage.getItem('splash-wiped')) {
      // Same-session return: hide immediately, no flash
      splash.style.display = 'none';
    } else {
      const el = splash; // capture as HTMLElement so nested functions stay non-null
      let touchStartY = 0;
      let touchDelta = 0;
      let isTouching = false;

      function dismiss() {
        el.style.transition = 'transform 0.5s cubic-bezier(0.45, 0, 0.2, 1), opacity 0.45s ease';
        el.style.transform = 'translateY(-100%)';
        el.style.opacity = '0';
        el.style.pointerEvents = 'none';
        sessionStorage.setItem('splash-wiped', '1');
        el.addEventListener('transitionend', () => { el.style.display = 'none'; }, { once: true });
      }

      // Touch: follow finger, dismiss if swiped up far enough
      el.addEventListener('touchstart', (e) => {
        isTouching = true;
        touchStartY = (e as TouchEvent).touches[0].clientY;
        touchDelta = 0;
        el.style.transition = 'none';
      }, { passive: true });

      el.addEventListener('touchmove', (e) => {
        const dy = touchStartY - (e as TouchEvent).touches[0].clientY;
        if (dy > 0) {
          touchDelta = dy;
          el.style.transform = `translateY(-${dy}px)`;
          el.style.opacity = String(Math.max(0, 1 - dy / 280));
        }
      }, { passive: true });

      el.addEventListener('touchend', () => {
        isTouching = false;
        if (touchDelta > 60) {
          dismiss();
        } else {
          // Snap back
          el.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
          el.style.transform = 'translateY(0)';
          el.style.opacity = '1';
          touchDelta = 0;
        }
      });

      // Click anywhere to dismiss (desktop tap / backup)
      el.addEventListener('click', dismiss);

      // Scroll to dismiss (desktop mouse wheel)
      window.addEventListener('scroll', function onScroll() {
        if (isTouching) return;
        if (window.scrollY > 8) {
          dismiss();
          window.removeEventListener('scroll', onScroll);
        }
      }, { passive: true });
    }
  }
</script>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--color-paper);
  }

  /* ── Photo mode ────────────────────────────────────────────── */
  .splash--photo { background: #1a1410; }

  .splash-photo {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.75;
  }

  .splash-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(18, 12, 8, 0.15) 0%,
      rgba(18, 12, 8, 0.45) 55%,
      rgba(18, 12, 8, 0.72) 100%
    );
  }

  .splash--photo .splash-eyebrow   { color: rgba(250, 248, 242, 0.68); }
  .splash--photo .splash-title     { color: #FAF8F2; }
  .splash--photo .splash-rule      { border-top-color: rgba(250, 248, 242, 0.22); }
  .splash--photo .splash-season    { color: rgba(250, 248, 242, 0.58); }
  .splash--photo .splash-season-label { color: rgba(250, 248, 242, 0.82); }
  .splash--photo .splash-cue       { color: rgba(250, 248, 242, 0.45); }

  /* ── Living texture ────────────────────────────────────────── */
  .splash-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .splash-blob--1 {
    width: clamp(320px, 52vw, 620px);
    height: clamp(320px, 52vw, 620px);
    top: -15%; left: -12%;
    background: rgba(126, 38, 37, 0.08);
    filter: blur(100px);
    animation: blobDrift1 22s ease-in-out infinite;
  }

  .splash-blob--2 {
    width: clamp(240px, 38vw, 480px);
    height: clamp(240px, 38vw, 480px);
    bottom: -10%; right: -8%;
    background: rgba(134, 139, 89, 0.09);
    filter: blur(90px);
    animation: blobDrift2 28s ease-in-out infinite;
  }

  .splash-blob--3 {
    width: clamp(180px, 28vw, 360px);
    height: clamp(180px, 28vw, 360px);
    top: 42%; left: 52%;
    background: rgba(212, 208, 191, 0.55);
    filter: blur(70px);
    animation: blobDrift3 18s ease-in-out infinite;
  }

  @keyframes blobDrift1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    38%       { transform: translate(40px, 35px) scale(1.07); }
    70%       { transform: translate(-18px, 55px) scale(0.94); }
  }

  @keyframes blobDrift2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    32%       { transform: translate(-40px, -30px) scale(1.1); }
    68%       { transform: translate(25px, -48px) scale(0.91); }
  }

  @keyframes blobDrift3 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50%       { transform: translate(-47%, -44%) scale(1.14); }
  }

  /* ── Centred content ───────────────────────────────────────── */
  .splash-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 0 var(--space-lg);
    max-width: 580px;
  }

  .splash-eyebrow {
    margin: 0 0 var(--space-lg);
    animation: splashFadeUp 0.9s ease both;
    animation-delay: 0.08s;
  }

  .splash-title {
    font-family: 'EB Garamond', Georgia, serif;
    font-weight: 500;
    font-size: var(--text-display);
    line-height: 1.08;
    color: var(--color-ink);
    margin: 0 0 var(--space-lg);
    animation: splashFadeUp 0.9s ease both;
    animation-delay: 0.26s;
  }

  .splash-rule {
    width: 52px;
    margin: 0 auto var(--space-lg);
    animation: splashFadeUp 0.9s ease both;
    animation-delay: 0.42s;
  }

  .splash-season {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: var(--text-body);
    color: var(--color-ink-muted);
    margin: 0;
    animation: splashFadeUp 0.9s ease both;
    animation-delay: 0.56s;
  }

  .splash-season-label {
    color: var(--color-olive);
    font-weight: 500;
    margin-right: 0.3em;
  }

  @keyframes splashFadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Scroll cue ────────────────────────────────────────────── */
  .splash-cue {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-ink-muted);
    opacity: 0;
    animation: splashFadeUp 0.7s ease 0.9s both, splashCueBounce 2.2s ease-in-out 1.2s infinite;
    z-index: 1;
  }

  .splash-cue-label {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: var(--text-eyebrow);
    font-style: italic;
    color: inherit;
    margin: var(--space-xs) 0 0;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  @keyframes splashCueBounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(7px); }
  }

</style>
