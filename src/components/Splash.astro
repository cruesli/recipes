---
import { SEASONAL_ITEMS, SEASON_LABEL } from '../data/seasonal';

interface Props {
  photo?: string;  // Optional path to full-bleed atmospheric photo
}

const { photo } = Astro.props;
---

<section class={`splash${photo ? ' splash--photo' : ''}`} aria-label="Welcome" data-splash>

  <!-- Living texture: drifting warm blobs (hidden in photo mode) -->
  {!photo && (
    <>
      <div class="splash-blob splash-blob--1" aria-hidden="true"></div>
      <div class="splash-blob splash-blob--2" aria-hidden="true"></div>
      <div class="splash-blob splash-blob--3" aria-hidden="true"></div>
    </>
  )}

  <!-- Photo mode background -->
  {photo && (
    <>
      <div class="splash-photo" style={`background-image: url('${photo}')`} aria-hidden="true"></div>
      <div class="splash-photo-overlay" aria-hidden="true"></div>
    </>
  )}

  <div class="splash-content">
    <h1 class="splash-title">Magnus &amp; Tessern's Recipes</h1>

    <!-- The pot: hairline ink line drawing (4.2 L round cocotte — generic,
         no brand marks); steam is the one oxblood element -->
    <figure class="splash-pot" aria-hidden="true">
      <svg viewBox="0 0 132 132" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <g class="pot-steam" stroke="var(--color-oxblood)">
          <path class="steam steam--1" d="M34,80 C29,72 38,64 33,54 C29,46 36,37 32,26" />
          <path class="steam steam--2" d="M78,77 C73,68 82,60 77,50 C73,42 80,33 76,22" />
          <path class="steam steam--3" d="M98,80 C103,72 94,64 99,53 C104,45 96,36 101,26" />
        </g>
        <g class="pot-lid" stroke="currentColor">
          <path d="M57,63 C57,58.5 61,56.5 66,56.5 C71,56.5 75,58.5 75,63" />
          <path d="M57,63 L75,63" />
          <path d="M61,63 L62.5,68.6" />
          <path d="M71,63 L69.5,68.6" />
          <path d="M18,84 C24,72 44,68 66,68 C88,68 108,72 114,84" />
          <path d="M14,84 L118,84" />
        </g>
        <g class="pot-body" stroke="currentColor">
          <path d="M18,86 C16.5,92 16,98 17,105 C18.5,117 30,124 66,124 C102,124 113.5,117 115,105 C116,98 115.5,92 114,86" />
          <path d="M17,91.5 C8,90.5 5.5,98 16.5,100.8" />
          <path d="M115,91.5 C124,90.5 126.5,98 115.5,100.8" />
        </g>
      </svg>
    </figure>

    <p class="splash-season">
      <span class="splash-season-label">{SEASON_LABEL}:</span>
      {SEASONAL_ITEMS.join(' · ')}
    </p>
  </div>

  <div class="splash-cue" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l5 5 5-5" />
    </svg>
    <p class="splash-cue-label">tap to explore</p>
  </div>
</section>

<script>
  function initSplash() {
    const splash = document.querySelector('[data-splash]') as HTMLElement | null;
    if (!splash) return;

    // Prevent double-init on the same DOM element (astro:page-load + immediate call)
    if ((splash as HTMLElement & { _splashInit?: boolean })._splashInit) return;
    (splash as HTMLElement & { _splashInit?: boolean })._splashInit = true;

    if (sessionStorage.getItem('splash-wiped')) {
      // Same-session return: hide immediately, no flash
      splash.style.display = 'none';
      return;
    }

    const el = splash;
    let touchStartY = 0;
    let touchDelta = 0;
    let isTouching = false;

    function dismiss() {
      sessionStorage.setItem('splash-wiped', '1');
      // Reduced motion: instant, no scroll-away, no burst
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        el.style.display = 'none';
        return;
      }
      el.classList.add('splash--dismissing'); // lid rattle-hop + puff, concurrent
      el.style.transition = 'transform 0.5s cubic-bezier(0.45, 0, 0.2, 1), opacity 0.45s ease';
      el.style.transform = 'translateY(-100%)';
      el.style.opacity = '0';
      el.style.pointerEvents = 'none';
      el.addEventListener('transitionend', () => { el.style.display = 'none'; }, { once: true });
    }

    // Touch: follow finger, dismiss if swiped up far enough
    el.addEventListener('touchstart', (e) => {
      isTouching = true;
      touchStartY = (e as TouchEvent).touches[0].clientY;
      touchDelta = 0;
      el.style.transition = 'none';
    }, { passive: true });

    el.addEventListener('touchmove', (e) => {
      const dy = touchStartY - (e as TouchEvent).touches[0].clientY;
      if (dy > 0) {
        touchDelta = dy;
        el.style.transform = `translateY(-${dy}px)`;
        el.style.opacity = String(Math.max(0, 1 - dy / 280));
      }
    }, { passive: true });

    el.addEventListener('touchend', () => {
      isTouching = false;
      if (touchDelta > 60) {
        dismiss();
      } else {
        // Snap back
        el.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
        el.style.transform = 'translateY(0)';
        el.style.opacity = '1';
        touchDelta = 0;
      }
    });

    // Click anywhere to dismiss (desktop tap / backup)
    el.addEventListener('click', dismiss);

    // Scroll to dismiss: listen for both scroll (scrollY) and wheel (fires before scrollY
    // updates — more reliable when a position:fixed overlay prevents the document from
    // actually scrolling far enough to change scrollY).
    function onScroll() {
      if (isTouching) return;
      if (window.scrollY > 8) { cleanup(); dismiss(); }
    }
    function onWheel(e: WheelEvent) {
      if (isTouching) return;
      if (e.deltaY > 0) { cleanup(); dismiss(); }
    }
    function cleanup() {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('wheel', onWheel as EventListener);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('wheel', onWheel, { passive: true });
  }

  // Run on ClientRouter navigations (fires on initial load too in Astro 5)
  document.addEventListener('astro:page-load', initSplash);
  // Also run immediately so it works without ClientRouter or if the event already fired
  initSplash();
</script>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--color-paper);
  }

  /* ── Photo mode ────────────────────────────────────────────── */
  .splash--photo { background: #1a1410; }

  .splash-photo {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.75;
  }

  .splash-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(18, 12, 8, 0.15) 0%,
      rgba(18, 12, 8, 0.45) 55%,
      rgba(18, 12, 8, 0.72) 100%
    );
  }

  .splash--photo .splash-title     { color: #FAF8F2; }
  .splash--photo .splash-pot       { color: rgba(250, 248, 242, 0.85); }
  .splash--photo .splash-season    { color: rgba(250, 248, 242, 0.58); }
  .splash--photo .splash-season-label { color: rgba(250, 248, 242, 0.82); }
  .splash--photo .splash-cue       { color: rgba(250, 248, 242, 0.45); }

  /* ── Living texture ────────────────────────────────────────── */
  .splash-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .splash-blob--1 {
    width: clamp(320px, 52vw, 620px);
    height: clamp(320px, 52vw, 620px);
    top: -15%; left: -12%;
    background: rgba(126, 38, 37, 0.08);
    filter: blur(100px);
    animation: blobDrift1 22s ease-in-out infinite;
  }

  .splash-blob--2 {
    width: clamp(240px, 38vw, 480px);
    height: clamp(240px, 38vw, 480px);
    bottom: -10%; right: -8%;
    background: rgba(134, 139, 89, 0.09);
    filter: blur(90px);
    animation: blobDrift2 28s ease-in-out infinite;
  }

  .splash-blob--3 {
    width: clamp(180px, 28vw, 360px);
    height: clamp(180px, 28vw, 360px);
    top: 42%; left: 52%;
    background: rgba(212, 208, 191, 0.55);
    filter: blur(70px);
    animation: blobDrift3 18s ease-in-out infinite;
  }

  @keyframes blobDrift1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    38%       { transform: translate(40px, 35px) scale(1.07); }
    70%       { transform: translate(-18px, 55px) scale(0.94); }
  }

  @keyframes blobDrift2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    32%       { transform: translate(-40px, -30px) scale(1.1); }
    68%       { transform: translate(25px, -48px) scale(0.91); }
  }

  @keyframes blobDrift3 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50%       { transform: translate(-47%, -44%) scale(1.14); }
  }

  /* ── Centred content ───────────────────────────────────────── */
  .splash-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 0 var(--space-lg);
    max-width: 640px;
  }

  .splash-title {
    font-family: 'EB Garamond', Georgia, serif;
    font-weight: 500;
    font-size: var(--text-display);
    line-height: 1.08;
    color: var(--color-ink);
    margin: 0 0 var(--space-lg);
    animation: splashFadeUp 0.9s ease both;
    animation-delay: 0.08s;
  }

  /* ── The pot (engraving figure) ────────────────────────────── */
  .splash-pot {
    width: clamp(110px, 16vw, 150px);
    margin: 0 auto var(--space-lg);
    color: var(--color-ink);
    animation: splashFadeUp 0.9s ease both;
    animation-delay: 0.3s;
  }

  .splash-pot svg { display: block; width: 100%; height: auto; }

  .splash-pot path,
  .splash-pot ellipse {
    stroke-width: 1.25px;
    vector-effect: non-scaling-stroke;
  }

  /* Idle: wisps drift up from under the lid rim and fade; pot body static */
  .steam {
    opacity: 0;
    animation: steamRise 4.2s ease-in-out infinite;
  }

  .steam--2 { animation-delay: 1.4s; }
  .steam--3 { animation-delay: 2.8s; }

  @keyframes steamRise {
    0%   { opacity: 0; transform: translateY(7px); }
    22%  { opacity: 0.55; }
    70%  { opacity: 0; transform: translateY(-13px); }
    100% { opacity: 0; transform: translateY(-13px); }
  }

  /* Dismiss burst: lid rattle-hop + stronger puff, concurrent with the
     scroll-away (never gating it) */
  .pot-lid {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  :global(.splash--dismissing) .pot-lid {
    animation: lidRattle 0.5s ease-out;
  }

  :global(.splash--dismissing) .steam {
    animation: steamPuff 0.5s ease-out forwards;
  }

  @keyframes lidRattle {
    0%   { transform: translateY(0) rotate(0deg); }
    22%  { transform: translateY(-4px) rotate(-1.6deg); }
    45%  { transform: translateY(0) rotate(1deg); }
    68%  { transform: translateY(-2px) rotate(-0.7deg); }
    100% { transform: translateY(0) rotate(0deg); }
  }

  @keyframes steamPuff {
    0%   { opacity: 0.6; transform: translateY(0) scale(1); }
    100% { opacity: 0; transform: translateY(-24px) scale(1.3); }
  }

  .splash-season {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: var(--text-body);
    color: var(--color-ink-muted);
    margin: 0;
    animation: splashFadeUp 0.9s ease both;
    animation-delay: 0.5s;
  }

  .splash-season-label {
    color: var(--color-olive);
    font-weight: 500;
    margin-right: 0.3em;
  }

  @keyframes splashFadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Scroll cue ────────────────────────────────────────────── */
  .splash-cue {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-ink-muted);
    opacity: 0;
    animation: splashFadeUp 0.7s ease 0.9s both, splashCueBounce 2.2s ease-in-out 1.2s infinite;
    z-index: 1;
  }

  .splash-cue-label {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: var(--text-eyebrow);
    font-style: italic;
    color: inherit;
    margin: var(--space-xs) 0 0;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  @keyframes splashCueBounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(7px); }
  }

  /* ── Reduced motion: static pot, no steam, everything settled ── */
  @media (prefers-reduced-motion: reduce) {
    .splash-blob,
    .splash-title,
    .splash-pot,
    .splash-season,
    .splash-cue,
    .pot-lid {
      animation: none;
    }
    .splash-title, .splash-pot, .splash-season, .splash-cue { opacity: 1; }
    .steam { display: none; }
  }
</style>
