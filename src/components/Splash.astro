---
import { SEASONAL_ITEMS, SEASON_LABEL } from '../data/seasonal';
---

<section class="splash" aria-label="Welcome" data-splash>

  <!-- Living texture: drifting warm blobs -->
  <div class="splash-blob splash-blob--1" aria-hidden="true"></div>
  <div class="splash-blob splash-blob--2" aria-hidden="true"></div>
  <div class="splash-blob splash-blob--3" aria-hidden="true"></div>

  <div class="splash-content">
    <h1 class="splash-title">Magnus &amp; Tessern's Recipes</h1>

    <!-- The pot: hairline ink line drawing (4.2 L round cocotte — generic, no
         brand marks). Steam wisps are dash segments travelling their paths with
         a gradient dissolve; inverse clip-paths (rect minus pot silhouette,
         evenodd) hide them behind the lid so they emerge from the rim seam.
         Line work draws itself in on load: body → lid → details. -->
    <figure class="splash-pot" aria-hidden="true">
      <svg viewBox="0 0 132 132" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <defs>
          <!-- Washed-ink steam: diluted ink stops + a whisper of blur -->
          <linearGradient id="splash-steam-grad" gradientUnits="userSpaceOnUse" x1="0" y1="88" x2="0" y2="18">
            <stop offset="0" style="stop-color: var(--color-ink)" stop-opacity="0.55" />
            <stop offset="0.6" style="stop-color: var(--color-ink)" stop-opacity="0.34" />
            <stop offset="1" style="stop-color: var(--color-ink)" stop-opacity="0" />
          </linearGradient>
          <filter id="splash-steam-soften" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="0.3" />
          </filter>
          <!-- Two clips (nested = intersection): knob block overlaps the lid
               region, so it lives in its own clip to keep evenodd parity clean -->
          <clipPath id="splash-steam-clip-a">
            <path clip-rule="evenodd" d="M0,0 H132 V132 H0 Z M20,78 L21.5,73.5 C33,64 47,61.3 66,61.3 C85,61.3 99,64 110.5,73.5 L112,78 Z M24,78 C23.5,87 23.5,96 24.6,103 C26,112.5 33,118.8 66,118.8 C99,118.8 106,112.5 107.4,103 C108.5,96 108.5,87 108,78 Z" />
          </clipPath>
          <clipPath id="splash-steam-clip-b">
            <path clip-rule="evenodd" d="M0,0 H132 V132 H0 Z M56,57.5 C56.5,52.5 60,50.8 66,50.8 C72,50.8 75.5,52.5 76,57.5 L76,64 L56,64 Z" />
          </clipPath>
        </defs>
        <g clip-path="url(#splash-steam-clip-a)">
          <g clip-path="url(#splash-steam-clip-b)">
            <g class="pot-steam" stroke="url(#splash-steam-grad)" filter="url(#splash-steam-soften)">
              <path class="steam steam--1" pathLength="1" d="M32,84 C40,72 25,63 32,51 C39,40 27,32 34,21" />
              <path class="steam steam--2" pathLength="1" d="M66,80 C72,66 59,57 66,45 C73,34 61,27 66,17" />
              <path class="steam steam--3" pathLength="1" d="M101,82 C95,73 107,65 101,54 C96,45 105,37 100,27" />
            </g>
          </g>
        </g>
        <g class="pot-lid" stroke="currentColor">
          <path class="pot-detail" pathLength="1" d="M56,57.5 C56.5,52.5 60,50.8 66,50.8 C72,50.8 75.5,52.5 76,57.5" />
          <path class="pot-detail" pathLength="1" d="M56,57.5 L76,57.5" />
          <path class="pot-detail" pathLength="1" d="M61,57.5 L62.2,61.4" />
          <path class="pot-detail" pathLength="1" d="M71,57.5 L69.8,61.4" />
          <path pathLength="1" d="M21.5,73.5 C33,64 47,61.3 66,61.3 C85,61.3 99,64 110.5,73.5" />
          <path class="pot-detail" pathLength="1" d="M33,69 C44,65.2 54,64 66,64 C78,64 88,65.2 99,69" />
          <path pathLength="1" d="M20,78 L21.5,73.5" />
          <path pathLength="1" d="M112,78 L110.5,73.5" />
          <path pathLength="1" d="M20,78 L112,78" />
        </g>
        <g class="pot-body" stroke="currentColor">
          <path pathLength="1" d="M24,78 C23.5,87 23.5,96 24.6,103 C26,112.5 33,118.8 66,118.8 C99,118.8 106,112.5 107.4,103 C108.5,96 108.5,87 108,78" />
          <path pathLength="1" d="M23.8,80.8 C11.5,81.6 10.5,90.6 23.9,91.2" />
          <path pathLength="1" d="M108.2,80.8 C120.5,81.6 121.5,90.6 108.1,91.2" />
          <path class="pot-ground" pathLength="1" d="M46,124.5 L86,124.5" />
        </g>
      </svg>
    </figure>

    <p class="splash-season">
      <span class="splash-season-label">{SEASON_LABEL}:</span>
      <span class="splash-season-items">{SEASONAL_ITEMS.join(' · ')}</span>
    </p>
  </div>

  <div class="splash-cue" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l5 5 5-5" />
    </svg>
    <p class="splash-cue-label">tap to explore</p>
  </div>
</section>

<script>
  import { seasonalFor } from '../data/seasonal';

  type SplashEl = HTMLElement & { _splashInit?: boolean; _splashShow?: () => void };

  function initSplash() {
    const found = document.querySelector('[data-splash]');
    if (!found) return;
    const el = found as SplashEl;

    // Prevent double-init on the same DOM element (astro:page-load + immediate call)
    if (el._splashInit) return;
    el._splashInit = true;

    // Self-updating season line: the baked-in list is from build time — re-derive
    // from the visitor's clock so a stale build can't show last season's produce
    const items = el.querySelector('.splash-season-items');
    if (items) items.textContent = seasonalFor(new Date().getMonth()).join(' · ');

    // Same-session return: hidden, but stays armed so the brand link can re-show it
    let active = !sessionStorage.getItem('splash-wiped');
    if (!active) el.style.display = 'none';

    let touchStartY = 0;
    let touchDelta = 0;
    let isTouching = false;
    let slideTimer = 0;
    let hideTimer = 0;

    function show() {
      sessionStorage.removeItem('splash-wiped');
      clearTimeout(slideTimer);
      clearTimeout(hideTimer);
      el.classList.remove('splash--dismissing');
      el.style.transition = 'none';
      el.style.transform = '';
      el.style.opacity = '';
      el.style.pointerEvents = '';
      el.style.display = ''; // display toggle restarts the entrance animations
      window.scrollTo(0, 0);
      active = true;
    }
    el._splashShow = show;

    function dismiss() {
      if (!active) return;
      active = false;
      sessionStorage.setItem('splash-wiped', '1');
      // Reduced motion: instant, no scroll-away, no burst
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        el.style.display = 'none';
        return;
      }
      el.classList.add('splash--dismissing'); // lid rattle-hop + steam puff
      el.style.pointerEvents = 'none';
      // Hold ~500 ms so the burst plays out, then scroll away
      slideTimer = window.setTimeout(() => {
        el.style.transition = 'transform 0.5s cubic-bezier(0.45, 0, 0.2, 1), opacity 0.45s ease';
        el.style.transform = 'translateY(-100%)';
        el.style.opacity = '0';
        hideTimer = window.setTimeout(() => { if (!active) el.style.display = 'none'; }, 600);
      }, 500);
    }

    // Touch: follow finger, dismiss if swiped up far enough
    el.addEventListener('touchstart', (e) => {
      if (!active) return;
      isTouching = true;
      touchStartY = (e as TouchEvent).touches[0].clientY;
      touchDelta = 0;
      el.style.transition = 'none';
    }, { passive: true });

    el.addEventListener('touchmove', (e) => {
      if (!active) return;
      const dy = touchStartY - (e as TouchEvent).touches[0].clientY;
      if (dy > 0) {
        touchDelta = dy;
        el.style.transform = `translateY(-${dy}px)`;
        el.style.opacity = String(Math.max(0, 1 - dy / 280));
      }
    }, { passive: true });

    el.addEventListener('touchend', () => {
      isTouching = false;
      if (!active) return;
      if (touchDelta > 60) {
        dismiss();
      } else {
        // Snap back
        el.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
        el.style.transform = 'translateY(0)';
        el.style.opacity = '1';
        touchDelta = 0;
      }
    });

    // Click anywhere to dismiss (desktop tap / backup)
    el.addEventListener('click', dismiss);

    // Scroll to dismiss: listen for both scroll (scrollY) and wheel (fires before scrollY
    // updates — more reliable when a position:fixed overlay prevents the document from
    // actually scrolling far enough to change scrollY). Guarded by `active` rather than
    // removed, so a re-shown splash dismisses again without rebinding.
    window.addEventListener('scroll', () => {
      if (isTouching || !active) return;
      if (window.scrollY > 8) dismiss();
    }, { passive: true });
    window.addEventListener('wheel', (e) => {
      if (isTouching || !active) return;
      if ((e as WheelEvent).deltaY > 0) dismiss();
    }, { passive: true });
  }

  // (The brand-link re-show listener lives in BaseLayout — it must exist on
  // every page, and this script only loads on pages that include the splash.)

  // Run on ClientRouter navigations (fires on initial load too in Astro 5)
  document.addEventListener('astro:page-load', initSplash);
  // Also run immediately so it works without ClientRouter or if the event already fired
  initSplash();
</script>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--color-paper);
  }

  /* ── Living texture ────────────────────────────────────────── */
  .splash-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .splash-blob--1 {
    width: clamp(320px, 52vw, 620px);
    height: clamp(320px, 52vw, 620px);
    top: -15%; left: -12%;
    background: rgba(126, 38, 37, 0.08);
    filter: blur(100px);
    animation: blobDrift1 22s ease-in-out infinite;
  }

  .splash-blob--2 {
    width: clamp(240px, 38vw, 480px);
    height: clamp(240px, 38vw, 480px);
    bottom: -10%; right: -8%;
    background: rgba(134, 139, 89, 0.09);
    filter: blur(90px);
    animation: blobDrift2 28s ease-in-out infinite;
  }

  .splash-blob--3 {
    width: clamp(180px, 28vw, 360px);
    height: clamp(180px, 28vw, 360px);
    top: 42%; left: 52%;
    background: rgba(212, 208, 191, 0.55);
    filter: blur(70px);
    animation: blobDrift3 18s ease-in-out infinite;
  }

  @keyframes blobDrift1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    38%       { transform: translate(40px, 35px) scale(1.07); }
    70%       { transform: translate(-18px, 55px) scale(0.94); }
  }

  @keyframes blobDrift2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    32%       { transform: translate(-40px, -30px) scale(1.1); }
    68%       { transform: translate(25px, -48px) scale(0.91); }
  }

  @keyframes blobDrift3 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50%       { transform: translate(-47%, -44%) scale(1.14); }
  }

  /* ── Centred content ───────────────────────────────────────── */
  .splash-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 0 var(--space-lg);
    max-width: 640px;
  }

  .splash-title {
    font-family: 'EB Garamond', Georgia, serif;
    font-weight: 500;
    font-size: var(--text-display);
    line-height: 1.08;
    color: var(--color-oxblood);
    margin: 0 0 var(--space-lg);
    animation: splashFadeUp 0.9s ease both;
    animation-delay: 0.08s;
  }

  /* ── The pot (engraving figure) ────────────────────────────── */
  .splash-pot {
    width: clamp(110px, 16vw, 150px);
    margin: 0 auto var(--space-lg);
    color: var(--color-oxblood);
  }

  .splash-pot svg { display: block; width: 100%; height: auto; }

  /* Plain user-unit strokes (no non-scaling-stroke): dash maths must be
     spec-uniform for the draw-in and steam-travel animations */
  .splash-pot path { stroke-width: 1.1px; }
  .pot-steam path { stroke-width: 0.9px; }

  /* Entrance: line work draws itself in — body, then lid contours, then
     details. dasharray "1 2" (pathLength=1): offset 1.02 hides the path with
     no wrap-around cap dot; offset 0 shows it fully. */
  .pot-lid path,
  .pot-body path {
    stroke-dasharray: 1 2;
    stroke-dashoffset: 0;
    animation: potDraw 1s cubic-bezier(0.6, 0, 0.3, 1) 0.35s both;
  }

  .pot-lid path { animation-delay: 0.55s; }
  path.pot-detail { animation-delay: 0.85s; }
  path.pot-ground { opacity: 0.3; animation-delay: 1.05s; }

  @keyframes potDraw {
    from { stroke-dashoffset: 1.02; }
    to   { stroke-dashoffset: 0; }
  }

  /* Idle: each wisp is a dash segment born at the rim seam, travelling up its
     path and dissolving into the gradient; pot body static. Staggered delays
     + unequal durations keep the three wisps drifting out of phase. */
  .steam {
    stroke-dasharray: 0.42 1.1;
    stroke-dashoffset: 0.45;
    animation: steamTravel 6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .steam--1 { animation-duration: 5.6s; animation-delay: 1.9s; }
  .steam--2 { animation-duration: 6.6s; animation-delay: 3.6s; }
  .steam--3 { animation-duration: 6.1s; animation-delay: 5s; }

  @keyframes steamTravel {
    from { stroke-dashoffset: 0.45; }
    to   { stroke-dashoffset: -1.02; }
  }

  /* Dismiss burst: lid rattle-hop + steam puff, concurrent with the
     scroll-away (never gating it) */
  .pot-lid {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  :global(.splash--dismissing) .pot-lid {
    animation: lidRattle 0.5s ease-out;
  }

  .pot-steam {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  :global(.splash--dismissing) .pot-steam {
    animation: steamPuff 0.5s ease-out forwards;
  }

  @keyframes lidRattle {
    0%   { transform: translateY(0) rotate(0deg); }
    22%  { transform: translateY(-4px) rotate(-1.6deg); }
    45%  { transform: translateY(0) rotate(1deg); }
    68%  { transform: translateY(-2px) rotate(-0.7deg); }
    100% { transform: translateY(0) rotate(0deg); }
  }

  @keyframes steamPuff {
    0%   { opacity: 1; transform: translateY(0) scale(1); }
    100% { opacity: 0; transform: translateY(-14px) scale(1.06); }
  }

  .splash-season {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: var(--text-body);
    color: var(--color-ink-muted);
    margin: 0;
    animation: splashFadeUp 0.9s ease both;
    animation-delay: 0.5s;
  }

  .splash-season-label {
    color: var(--color-olive);
    font-weight: 500;
    margin-right: 0.3em;
  }

  @keyframes splashFadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Scroll cue ────────────────────────────────────────────── */
  .splash-cue {
    position: absolute;
    bottom: var(--space-xl);
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-ink-muted);
    opacity: 0;
    animation: splashFadeUp 0.7s ease 0.9s both, splashCueBounce 2.2s ease-in-out 1.2s infinite;
    z-index: 1;
  }

  .splash-cue-label {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: var(--text-eyebrow);
    font-style: italic;
    color: inherit;
    margin: var(--space-xs) 0 0;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  @keyframes splashCueBounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(7px); }
  }

  /* ── Reduced motion: static pot, no steam, everything settled ── */
  @media (prefers-reduced-motion: reduce) {
    .splash-blob,
    .splash-title,
    .splash-season,
    .splash-cue,
    .pot-lid,
    .pot-steam,
    .splash-pot path {
      animation: none;
    }
    .splash-title, .splash-season, .splash-cue { opacity: 1; }
    .steam { display: none; }
  }
</style>
