---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { WorldMap } from "../components/WorldMap";
import { CollectionPlannerIsland } from "../components/CollectionPlannerIsland";
import { silhouetteFor } from "../utils/silhouettes";
import Splash from "../components/Splash.astro";

const recipes = await getCollection("recipes");
// Newest-first for the home preview (the top changes when a recipe lands);
// undated recipes fall to the back, ties broken by title.
const added = (r: (typeof recipes)[number]) => r.data.date?.valueOf() ?? 0;
recipes.sort((a, b) => added(b) - added(a) || a.data.title.localeCompare(b.data.title));


const allRecipes = recipes.map((r) => ({
  id: r.slug,
  title: r.data.title,
  cuisine: r.data.cuisine,
  image: r.data.image ?? null,
  totalTimeMinutes: r.data.totalTimeMinutes ?? null,
  servings: r.data.servings ?? null,
  ingredients: r.data.ingredients ?? [],
  silhouette: silhouetteFor(r.data.cuisine),
}));

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

// Load cuisines tree for the WorldMap (narrow the meta-collection union)
const cuisinesEntry = await getEntry('meta', 'cuisines');
const cuisinesData =
  cuisinesEntry && 'cuisines' in cuisinesEntry.data ? cuisinesEntry.data.cuisines : [];
---

<BaseLayout title="Home">
  <!-- Splash -->
  <Splash />

  <!-- Collection + Planner side-by-side -->
  <section class="main-section">
    <CollectionPlannerIsland
      recipes={allRecipes}
      basePath={basePath}
      previewLimit={6}
      viewAllHref={`${basePath}/recipes`}
      client:load
    />
  </section>

  <!-- Explore by place -->
  <section class="map-section" id="map">
    <div class="container">
      <div class="section-tick"></div>
      <p class="section-label">Explore</p>
      <h2 class="section-heading">Around the world</h2>
    </div>
    <!-- Server-rendered frame: reserves the map's height pre-hydration so anchor
         scroll and the reverse-morph rect are measurable at astro:after-swap -->
    <div class="worldmap-frame">
      <WorldMap
        recipeCuisines={recipes.map(r => r.data.cuisine.toLowerCase())}
        cuisinesData={cuisinesData}
        basePath={basePath}
        client:only="react"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* ── World map ────────────────────────────────────────────── */
  .map-section {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-4xl);
  }

  .section-heading {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: var(--text-section);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0 0 var(--space-xl);
  }

  .map-hint {
    font-size: var(--text-meta);
    color: var(--color-ink-muted);
    margin: calc(-1 * var(--space-md)) 0 var(--space-lg);
  }
</style>
