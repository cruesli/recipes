---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { MealPlannerIsland } from "../components/MealPlannerIsland";

const recipes = await getCollection("recipes");
const recipeData = recipes.map((r) => ({
  id: r.slug,
  title: r.data.title,
  cuisine: r.data.cuisine,
  image: r.data.image ?? null,
  totalTimeMinutes: r.data.totalTimeMinutes ?? null,
  servings: r.data.servings ?? null,
  ingredients: r.data.ingredients ?? [],
}));

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Meal Planner" showPlanner={false}>
  <MealPlannerIsland
    recipes={recipeData}
    basePath={basePath}
    client:load
  />
</BaseLayout>
