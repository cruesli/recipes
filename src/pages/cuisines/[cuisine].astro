---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { displayFromSlug } from "../../utils/displayFromSlug";
import { cuisineLabel, getDescendants, type CuisineItem } from "../../utils/cuisines";
import { withBase } from "../../utils/withBase";
import { RecipeCard } from "../../components/RecipeCard";
import { silhouetteFor } from "../../utils/silhouettes";
import { deriveTotalTime } from "../../lib/recipeTime.mjs";
import manifest from "../../generated/silhouettes/manifest.json";

export async function getStaticPaths() {
  const cuisinesEntry = await getEntry("meta", "cuisines");
  // Narrow the meta-collection union (cuisines.json | country-regions.json)
  if (!cuisinesEntry || !("cuisines" in cuisinesEntry.data)) return [];
  return cuisinesEntry.data.cuisines.map((c: CuisineItem) => ({
    params: { cuisine: c.slug },
  }));
}

const { cuisine } = Astro.params;

const cuisinesEntry = await getEntry("meta", "cuisines");
const cuisines =
  cuisinesEntry && "cuisines" in cuisinesEntry.data ? cuisinesEntry.data.cuisines : [];

// Find the entry for this slug
const current = cuisines.find(
  (c: CuisineItem) => c.slug === String(cuisine)
);

const title = current
  ? cuisineLabel(current)
  : displayFromSlug(String(cuisine));

// Collect matching slugs (the slug itself + any leaves if it's a region)
const matchingSlugs = new Set(getDescendants(String(cuisine), cuisines));

const recipes = await getCollection("recipes", ({ data }) =>
  matchingSlugs.has(data.cuisine)
);

recipes.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Inline silhouette, emitted by the prebuild generator (static HTML at first paint)
const silhouettes = import.meta.glob("../../generated/silhouettes/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const silhouette = silhouettes[`../../generated/silhouettes/${cuisine}.svg`] as
  | string
  | undefined;

// Plate aspect ratio (projected bbox) — drives the area-budget sizing below
const bbox = (manifest as Record<string, { width: number; height: number }>)[
  String(cuisine)
];
const plateAspect = bbox ? bbox.width / bbox.height : 1;

// Region-plate variant (mini country-mode map). Aliveness is strict leaf-only,
// decided here against the collection; used only when ≥1 leaf is alive —
// otherwise the solid silhouette stands (an all-tan plate would read dead).
interface RegionPlate {
  viewBox: string;
  leaves: { slug: string; d: string }[];
  inert: string[];
}
const plates = import.meta.glob("../../generated/silhouettes/*.plate.json", {
  import: "default",
  eager: true,
});
const plate = plates[`../../generated/silhouettes/${cuisine}.plate.json`] as
  | RegionPlate
  | undefined;

const allRecipes = await getCollection("recipes");
const leafCounts = new Map<string, number>();
allRecipes.forEach((r) =>
  leafCounts.set(r.data.cuisine, (leafCounts.get(r.data.cuisine) ?? 0) + 1)
);

const plateLeaves = (plate?.leaves ?? []).map((l) => {
  const entry = cuisines.find((c: CuisineItem) => c.slug === l.slug);
  const count = leafCounts.get(l.slug) ?? 0;
  return { ...l, count, label: cuisineLabel(entry ?? { slug: l.slug }) };
});
const regionPlate = plateLeaves.some((l) => l.count > 0) ? plate : undefined;
---

<BaseLayout title={title}>
  <div class="chapter-shell">
    <!-- Chapter backdrop: the arrival visual — near-viewport, softly faded
         sage land behind the opener and the top of the grid. The morph flies
         the clicked map shape into it, so the click reads as zooming into the
         country; the recipes lie on the land as it fades out beneath them. -->
    {regionPlate ? (
      <div
        class="cuisine-silhouette chapter-backdrop region-plate"
        style={`--plate-ar: ${plateAspect.toFixed(4)}`}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox={regionPlate.viewBox}
          role="group"
          aria-label={`${title} — the cuisines inside`}
        >
          {regionPlate.inert.map((d) => (
            <path d={d} class="plate-inert" />
          ))}
          {plateLeaves.map((l) =>
            l.count > 0 ? (
              <path
                d={l.d}
                class="plate-leaf"
                data-leaf-href={withBase(`/cuisines/${l.slug}`)}
                tabindex="0"
                role="button"
                aria-label={`${l.label} cuisine, ${l.count} ${l.count === 1 ? "recipe" : "recipes"}`}
              />
            ) : (
              <path d={l.d} class="plate-inert" />
            )
          )}
        </svg>
      </div>
    ) : silhouette && (
      <div
        class="cuisine-silhouette chapter-backdrop"
        aria-hidden="true"
        style={`--plate-ar: ${plateAspect.toFixed(4)}`}
        set:html={silhouette}
      />
    )}

    <div class="cuisine-frame">
      <a class="back-to-map" href={withBase("/#map")}>← Back to the map</a>

      <!-- Chapter opener: tick → eyebrow → title → count → (the land) → grid -->
      <div class="section-tick"></div>
      <p class="eyebrow cuisine-eyebrow">Cuisine</p>
      <h1 class="cuisine-title">{title}</h1>
      <p class="cuisine-count onum">
        {recipes.length} {recipes.length === 1 ? "recipe" : "recipes"}
      </p>

      {recipes.length > 0 ? (
        <div class="recipe-grid">
          {recipes.map((r) => (
            <RecipeCard
              href={withBase(`/recipes/${r.slug}`)}
              imageSrc={r.data.image ? withBase(r.data.image) : null}
              silhouette={silhouetteFor(r.data.cuisine)}
              eyebrow={r.data.tags?.[0]}
              title={r.data.title}
              meta={[
                deriveTotalTime(r.data) ? `${deriveTotalTime(r.data)} min` : null,
                r.data.servings ? `${r.data.servings} servings` : null,
                r.data.tags?.[1],
              ]}
            />
          ))}
        </div>
      ) : (
        <p class="empty-note">Nothing written down from this kitchen yet.</p>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  // Region-plate leaf navigation — map grammar, navigate (never filter).
  // Module script: runs once, document-level delegation survives router swaps.
  import { navigate } from "astro:transitions/client";

  const leafOf = (e: Event) =>
    (e.target as Element).closest?.("[data-leaf-href]") as SVGPathElement | null;

  // Stash the region → leaf hop (consume-once) so the leaf page's back link
  // returns to the region chapter instead of the full map
  const HOP_KEY = "cuisine:back";

  function goToLeaf(el: SVGPathElement) {
    try {
      sessionStorage.setItem(HOP_KEY, JSON.stringify({
        href: location.pathname,
        label: document.querySelector(".cuisine-title")?.textContent?.trim() ?? "the region",
      }));
    } catch { /* private mode: back link stays "Back to the map" */ }
    navigate(el.getAttribute("data-leaf-href")!);
  }

  document.addEventListener("click", (e) => {
    const el = leafOf(e);
    if (el) goToLeaf(el);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Enter" && e.key !== " ") return;
    const el = leafOf(e);
    if (!el) return;
    e.preventDefault();
    goToLeaf(el);
  });

  // Arriving from a region plate: re-point the back link at the region chapter
  const rewriteBackLink = () => {
    let raw: string | null = null;
    try {
      raw = sessionStorage.getItem(HOP_KEY);
      if (raw) sessionStorage.removeItem(HOP_KEY);
    } catch { return; }
    if (!raw) return;
    try {
      const { href, label } = JSON.parse(raw);
      const back = document.querySelector("a.back-to-map");
      if (back && href && href !== location.pathname) {
        back.setAttribute("href", href);
        back.textContent = `← Back to ${label}`;
      }
    } catch { /* corrupt marker: keep the map link */ }
  };
  document.addEventListener("astro:page-load", rewriteBackLink);

  // Small viewports: region plates are decorative — drop focus/ARIA as well
  // (CSS already kills pointer events under 768px)
  const strip = () => {
    if (!window.matchMedia("(max-width: 767px)").matches) return;
    document.querySelectorAll("[data-leaf-href]").forEach((el) => {
      ["tabindex", "role", "aria-label", "data-leaf-href"].forEach((a) =>
        el.removeAttribute(a)
      );
    });
  };
  document.addEventListener("astro:page-load", strip);
</script>

<style>
  /* Chapter shell: full-width positioning context. `overflow: clip` swallows
     the backdrop's edge bleed (no sideways page scroll) and its overrun below
     short grids; min-height guarantees a full "chapter cover" beat even for
     two-recipe cuisines. */
  .chapter-shell {
    position: relative;
    overflow: clip;
    min-height: 92vh;
  }

  /* The chapter backdrop — replaces the area-budget plate: near-viewport,
     softly faded sage, anchored right and allowed to bleed a little off the
     edge (never so far the country stops being recognizable). The bottom
     dissolves under the grid via the mask. Faded tones come from color-mix
     (not opacity) so leaf hover keeps its own contrast. */
  .chapter-backdrop {
    position: absolute;
    top: -6vh;
    right: -6vw;
    width: min(calc(var(--plate-ar, 1) * 88vh), 112vw);
    color: color-mix(in srgb, var(--color-map-active) 42%, var(--color-paper));
    mask-image: linear-gradient(to bottom, black 55%, transparent 97%);
    -webkit-mask-image: linear-gradient(to bottom, black 55%, transparent 97%);
    view-transition-name: cuisine-shape;
  }

  .cuisine-silhouette :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Browse frame rides above the land; pointer-events pass through the empty
     areas so region-backdrop leaves stay clickable behind it */
  .cuisine-frame {
    position: relative;
    z-index: 1;
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: var(--space-md) var(--space-lg);
    pointer-events: none;
    animation: chapterRise 0.45s ease 0.1s both;
  }

  .cuisine-frame > * { pointer-events: auto; }

  /* Arrival: content rises in just after the shape lands (C choreography) */
  @keyframes chapterRise {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cuisine-frame { animation: none; }
  }

  .back-to-map {
    display: inline-block;
    font-family: var(--font-family-serif);
    font-size: var(--text-meta);
    color: var(--color-ink-muted);
    text-decoration: none;
    margin: 0 0 var(--space-lg);
  }

  .back-to-map:hover { color: var(--color-oxblood); }

  .cuisine-eyebrow { margin: 0 0 var(--space-xs); }

  .cuisine-title {
    font-family: var(--font-family-serif);
    font-size: var(--text-title);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0 0 var(--space-2xs);
  }

  /* The count closes the opener; the big margin is the "chapter cover" beat —
     the land gets a clear moment before the recipes roll over it */
  .cuisine-count {
    font-size: var(--text-meta);
    color: var(--color-ink-muted);
    margin: 0 0 clamp(150px, 30vh, 340px);
  }

  /* Region backdrop: mini country-mode map — map grammar in the faded key */
  .region-plate path {
    stroke: var(--color-paper);
    stroke-width: 1.25px;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .plate-inert { fill: color-mix(in srgb, var(--color-map-active) 34%, var(--color-paper)); }

  .plate-leaf {
    fill: color-mix(in srgb, var(--color-map-active) 50%, var(--color-paper));
    cursor: pointer;
    transition: fill 0.2s ease;
    outline: none;
  }

  .plate-leaf:hover,
  .plate-leaf:focus-visible { fill: color-mix(in srgb, var(--color-olive) 68%, var(--color-paper)); }
  .plate-leaf:focus-visible { outline: 2px solid var(--color-oxblood); }

  /* Mobile keeps the arrival visual (tighter caps); region backdrops go
     decorative — no tap targets (fat-finger honesty; the script strips
     focus/ARIA too) */
  @media (max-width: 767px) {
    .chapter-shell { min-height: 70vh; }
    .chapter-backdrop {
      top: -2vh;
      right: -10vw;
      width: min(calc(var(--plate-ar, 1) * 52vh), 135vw);
    }
    .region-plate path { pointer-events: none; }
    .cuisine-count { margin-bottom: clamp(90px, 18vh, 200px); }
  }

  /* Same fixed 3-column browse grid as home + /recipes (1 column < 768px) */
  .recipe-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xl) var(--space-lg);
  }

  @media (max-width: 768px) {
    .recipe-grid { grid-template-columns: 1fr; }
  }

  .empty-note {
    color: var(--color-ink-muted);
    font-style: italic;
    font-size: var(--text-meta);
  }
</style>
