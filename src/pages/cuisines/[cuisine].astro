---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { displayFromSlug } from "../../utils/displayFromSlug";
import { cuisineLabel } from "../../utils/cuisines";
import { withBase } from "../../utils/withBase";
import { RecipeCard } from "../../components/RecipeCard";

export async function getStaticPaths() {
  const cuisinesEntry = await getEntry("meta", "cuisines");
  if (!cuisinesEntry) return [];
  return cuisinesEntry.data.cuisines.map((c: { slug: string }) => ({
    params: { cuisine: c.slug },
  }));
}

const { cuisine } = Astro.params;

const cuisinesEntry = await getEntry("meta", "cuisines");
const cuisines = cuisinesEntry?.data.cuisines ?? [];

const current = cuisines.find(
  (c: { slug: string }) => c.slug.toLowerCase() === String(cuisine).toLowerCase()
);

const title = current
  ? cuisineLabel(current)
  : displayFromSlug(String(cuisine));

const recipes = await getCollection("recipes", ({ data }) =>
  data.cuisine.toLowerCase() === String(cuisine).toLowerCase()
);

recipes.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title={title}>
  <p class="eyebrow" style="margin: 0 0 var(--space-xs);">Cuisine</p>
  <h1 class="cuisine-title">{title}</h1>
  <p class="cuisine-count onum">
    {recipes.length} {recipes.length === 1 ? "recipe" : "recipes"}
  </p>

  {recipes.length > 0 ? (
    <div class="recipe-grid">
      {recipes.map((r) => (
        <RecipeCard
          href={withBase(`/recipes/${r.slug}`)}
          imageSrc={r.data.image ? withBase(r.data.image) : null}
          eyebrow={r.data.tags?.[0]}
          title={r.data.title}
          meta={[
            r.data.totalTimeMinutes ? `${r.data.totalTimeMinutes} min` : null,
            r.data.servings ? `${r.data.servings} servings` : null,
            r.data.tags?.[1],
          ]}
        />
      ))}
    </div>
  ) : (
    <p class="empty-note">No recipes for this cuisine yet.</p>
  )}
</BaseLayout>

<style>
  .cuisine-title {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: var(--text-title);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0 0 var(--space-2xs);
  }

  .cuisine-count {
    font-size: var(--text-meta);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-2xl);
  }

  .recipe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0 var(--space-lg);
  }

  .empty-note {
    color: var(--color-ink-muted);
    font-style: italic;
    font-size: var(--text-meta);
  }
</style>
