---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { displayFromSlug } from "../../utils/displayFromSlug";
import { cuisineLabel, getDescendants, type CuisineItem } from "../../utils/cuisines";
import { withBase } from "../../utils/withBase";
import { RecipeCard } from "../../components/RecipeCard";
import manifest from "../../generated/silhouettes/manifest.json";

export async function getStaticPaths() {
  const cuisinesEntry = await getEntry("meta", "cuisines");
  // Narrow the meta-collection union (cuisines.json | country-regions.json)
  if (!cuisinesEntry || !("cuisines" in cuisinesEntry.data)) return [];
  return cuisinesEntry.data.cuisines.map((c: CuisineItem) => ({
    params: { cuisine: c.slug },
  }));
}

const { cuisine } = Astro.params;

const cuisinesEntry = await getEntry("meta", "cuisines");
const cuisines =
  cuisinesEntry && "cuisines" in cuisinesEntry.data ? cuisinesEntry.data.cuisines : [];

// Find the entry for this slug
const current = cuisines.find(
  (c: CuisineItem) => c.slug === String(cuisine)
);

const title = current
  ? cuisineLabel(current)
  : displayFromSlug(String(cuisine));

// Collect matching slugs (the slug itself + any leaves if it's a region)
const matchingSlugs = new Set(getDescendants(String(cuisine), cuisines));

const recipes = await getCollection("recipes", ({ data }) =>
  matchingSlugs.has(data.cuisine)
);

recipes.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Inline silhouette, emitted by the prebuild generator (static HTML at first paint)
const silhouettes = import.meta.glob("../../generated/silhouettes/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const silhouette = silhouettes[`../../generated/silhouettes/${cuisine}.svg`] as
  | string
  | undefined;

// Plate aspect ratio (projected bbox) — drives the area-budget sizing below
const bbox = (manifest as Record<string, { width: number; height: number }>)[
  String(cuisine)
];
const plateAspect = bbox ? bbox.width / bbox.height : 1;
---

<BaseLayout title={title}>
  <div class="cuisine-frame">
    <a class="back-to-map" href={withBase("/#map")}>← Back to the map</a>

    <!-- Chapter opener: tick → eyebrow → title → count → the plate -->
    <div class="section-tick"></div>
    <p class="eyebrow cuisine-eyebrow">Cuisine</p>
    <h1 class="cuisine-title">{title}</h1>
    <p class="cuisine-count onum">
      {recipes.length} {recipes.length === 1 ? "recipe" : "recipes"}
    </p>

    {silhouette && (
      <div
        class="cuisine-silhouette chapter-plate"
        aria-hidden="true"
        style={`--plate-ar: ${plateAspect.toFixed(4)}`}
        set:html={silhouette}
      />
    )}

    {recipes.length > 0 ? (
      <div class="recipe-grid">
        {recipes.map((r) => (
          <RecipeCard
            href={withBase(`/recipes/${r.slug}`)}
            imageSrc={r.data.image ? withBase(r.data.image) : null}
            eyebrow={r.data.tags?.[0]}
            title={r.data.title}
            meta={[
              r.data.totalTimeMinutes ? `${r.data.totalTimeMinutes} min` : null,
              r.data.servings ? `${r.data.servings} servings` : null,
              r.data.tags?.[1],
            ]}
          />
        ))}
      </div>
    ) : (
      <p class="empty-note">No recipes for this cuisine yet.</p>
    )}
  </div>
</BaseLayout>

<style>
  /* Browse frame (full-width layout, no sidebar) */
  .cuisine-frame {
    max-width: var(--max-wide);
    margin: 0 auto;
    padding: var(--space-md) var(--space-lg);
  }

  .back-to-map {
    display: inline-block;
    font-family: var(--font-family-serif);
    font-size: var(--text-meta);
    color: var(--color-ink-muted);
    text-decoration: none;
    margin: 0 0 var(--space-lg);
  }

  .back-to-map:hover { color: var(--color-oxblood); }

  .cuisine-eyebrow { margin: 0 0 var(--space-xs); }

  .cuisine-title {
    font-family: var(--font-family-serif);
    font-size: var(--text-title);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0 0 var(--space-2xs);
  }

  .cuisine-count {
    font-size: var(--text-meta);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-xl);
  }

  /* The chapter plate: area budget (never full-bleed) — height capped by
     --plate-max-h, width by 60% of the frame; the shape's own viewBox aspect
     (--plate-ar, set inline) resolves which constraint binds. */
  .chapter-plate {
    --plate-max-h: clamp(240px, 34vh, 420px);
    color: var(--color-map-active);
    width: min(60%, calc(var(--plate-max-h) * var(--plate-ar, 1)));
    margin: 0 0 var(--space-3xl);
  }

  .cuisine-silhouette :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    view-transition-name: cuisine-shape;
  }

  /* Mobile keeps the arrival visual, slightly tighter cap */
  @media (max-width: 767px) {
    .chapter-plate {
      --plate-max-h: 38vh;
      width: min(100%, calc(var(--plate-max-h) * var(--plate-ar, 1)));
    }
  }

  .recipe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0 var(--space-lg);
  }

  .empty-note {
    color: var(--color-ink-muted);
    font-style: italic;
    font-size: var(--text-meta);
  }
</style>
