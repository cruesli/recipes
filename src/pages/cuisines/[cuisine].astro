---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { displayFromSlug } from "../../utils/displayFromSlug";
import { cuisineLabel } from "../../utils/cuisines";
import { withBase } from "../../utils/withBase";

export async function getStaticPaths() {
  const cuisinesEntry = await getEntry("meta", "cuisines");
  if (!cuisinesEntry) return [];
  return cuisinesEntry.data.cuisines.map((c: { slug: string }) => ({
    params: { cuisine: c.slug },
  }));
}

const { cuisine } = Astro.params;

const cuisinesEntry = await getEntry("meta", "cuisines");
const cuisines = cuisinesEntry?.data.cuisines ?? [];

const current = cuisines.find(
  (c: { slug: string }) => c.slug.toLowerCase() === String(cuisine).toLowerCase()
);

const title = current
  ? cuisineLabel(current)
  : displayFromSlug(String(cuisine));

const recipes = await getCollection("recipes", ({ data }) =>
  data.cuisine.toLowerCase() === String(cuisine).toLowerCase()
);

recipes.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title={title}>
  <p class="section-label">Cuisine</p>
  <h1 style="font-size: 2rem; color: var(--color-ink); margin: 0 0 6px;">{title}</h1>
  <p style="font-size: 0.9rem; color: var(--color-ink-muted); margin: 0 0 1.75rem;">
    {recipes.length} {recipes.length === 1 ? "recipe" : "recipes"}
  </p>

  {recipes.length > 0 ? (
    <div class="grid">
      {recipes.map((r) => (
        <a class="card" href={withBase(`/recipes/${r.slug}`)}>
          {r.data.image && (
            <img src={withBase(r.data.image)} alt={r.data.title} loading="lazy" />
          )}
          <h2 style="margin: 0 0 6px; font-size: 1rem; font-weight: 500; color: var(--color-ink);">{r.data.title}</h2>
          <div class="badges">
            {r.data.totalTimeMinutes && (
              <span class="badge badge-meta">{r.data.totalTimeMinutes} min</span>
            )}
            {r.data.servings && (
              <span class="badge badge-meta">{r.data.servings} servings</span>
            )}
            {r.data.tags?.slice(0, 2).map((t: string) => (
              <span class="badge badge-tag">{t}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  ) : (
    <p style="color: var(--color-ink-muted); font-style: italic;">
      No recipes for this cuisine yet.
    </p>
  )}
</BaseLayout>
