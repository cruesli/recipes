---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { RecipePageIsland } from "../../components/RecipePageIsland";
import { deriveTotalTime } from "../../lib/recipeTime.mjs";
import { getEnriched } from "../../lib/enrichment";
import { displayFromSlug } from "../../utils/displayFromSlug";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes.map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;

const recipes = await getCollection("recipes");
const recipe = recipes.find((r) => r.slug === slug);

if (!recipe) throw new Error(`Recipe not found: ${slug}`);

const d = recipe.data;

// Ingredients: the content schema already normalises string input to string[]
const ingredients: string[] = d.ingredients ?? [];

// Steps: parse numbered list items from raw markdown body
const steps: string[] = recipe.body
  .split(/\n(?=\d+\.)/)
  .map((chunk) => chunk.replace(/^\d+\.\s*/, "").trim())
  .filter(Boolean);

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

// Per-serving nutrition from the KG export (null when this recipe isn't in it)
const nutrition = getEnriched(slug!)?.nutritionPerServing ?? null;
---

<BaseLayout title={d.title}>
  <RecipePageIsland
    title={d.title}
    intro={d.intro ?? null}
    cuisine={displayFromSlug(d.cuisine)}
    totalTimeMinutes={deriveTotalTime(d)}
    servings={d.servings ?? 4}
    image={d.image ?? null}
    foodType={d.foodType ?? null}
    tags={d.tags ?? []}
    ingredients={ingredients}
    steps={steps}
    nutrition={nutrition}
    basePath={basePath}
    client:load
  />
</BaseLayout>
