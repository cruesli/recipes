---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { RecipePageIsland } from "../../components/RecipePageIsland";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes.map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;

const recipes = await getCollection("recipes");
const recipe = recipes.find((r) => r.slug === slug);

if (!recipe) throw new Error(`Recipe not found: ${slug}`);

const d = recipe.data;

// Ingredients: already parsed by content schema into string[]
const rawIngredients = d.ingredients as unknown;
const ingredients: string[] = Array.isArray(rawIngredients)
  ? (rawIngredients as string[])
  : typeof rawIngredients === "string"
  ? (rawIngredients as string)
      .split(/\r?\n/)
      .map((l: string) => l.trim().replace(/^-+\s*/, ""))
      .filter(Boolean)
  : [];

// Steps: parse numbered list items from raw markdown body
const steps: string[] = recipe.body
  .split(/\n(?=\d+\.)/)
  .map((chunk) => chunk.replace(/^\d+\.\s*/, "").trim())
  .filter(Boolean);

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={d.title} fullWidth={true}>
  <RecipePageIsland
    title={d.title}
    cuisine={d.cuisine}
    totalTimeMinutes={d.totalTimeMinutes ?? null}
    servings={d.servings ?? 4}
    image={d.image ?? null}
    foodType={d.foodType ?? null}
    tags={d.tags ?? []}
    ingredients={ingredients}
    steps={steps}
    basePath={basePath}
    client:load
  />
</BaseLayout>
