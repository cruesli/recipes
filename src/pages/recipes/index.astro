---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { CollectionPlannerIsland } from "../../components/CollectionPlannerIsland";
import { silhouetteFor } from "../../utils/silhouettes";
import { deriveTotalTime } from "../../lib/recipeTime.mjs";
import { getEnriched } from "../../lib/enrichment";

const recipes = await getCollection("recipes");
recipes.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Dietary flags from frontmatter tags (authoritative; vegan implies vegetarian)
function dietaryFor(tags: string[]): string[] {
  const lower = tags.map((t) => t.toLowerCase());
  if (lower.includes("vegan")) return ["vegan", "vegetarian"];
  if (lower.includes("vegetarian")) return ["vegetarian"];
  return [];
}

const allRecipes = recipes.map((r) => {
  const n = getEnriched(r.slug)?.nutritionPerServing ?? null;
  return {
    id: r.slug,
    title: r.data.title,
    cuisine: r.data.cuisine,
    image: r.data.image ?? null,
    totalTimeMinutes: deriveTotalTime(r.data),
    servings: r.data.servings ?? null,
    ingredients: r.data.ingredients ?? [],
    silhouette: silhouetteFor(r.data.cuisine),
    dietary: dietaryFor(r.data.tags ?? []),
    kcalPerServing: n?.kcal ?? null,
    proteinPerServing: n?.proteinG ?? null,
  };
});

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const nlpApiUrl = import.meta.env.PUBLIC_NLP_API_URL ?? null;
---

<BaseLayout title="Recipes">
  <CollectionPlannerIsland
    recipes={allRecipes}
    basePath={basePath}
    facets={true}
    nlpApiUrl={nlpApiUrl}
    client:load
  />
</BaseLayout>
