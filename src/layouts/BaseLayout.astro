---
import { withBase } from "../utils/withBase";
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { PlannerDrawer } from "../components/PlannerDrawer";

interface Props {
  title?: string;
  description?: string;
  showPlanner?: boolean;
}

const {
  title = "Magnus & Tessern's Recipes",
  description = "A household cookbook — the recipes Magnus & Tessern actually cook, written down.",
  showPlanner = true,
} = Astro.props;

// Absolute URL for social cards (SVG mark; swap for a raster when one exists)
const ogImage = new URL(withBase("/favicon.svg"), Astro.site).href;

const recipes = await getCollection("recipes");

const allRecipes = recipes.map((r) => ({
  id: r.slug,
  title: r.data.title,
  cuisine: r.data.cuisine,
  image: r.data.image ?? null,
  totalTimeMinutes: r.data.totalTimeMinutes ?? null,
  servings: r.data.servings ?? null,
  ingredients: r.data.ingredients ?? [],
}));

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Recipes</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <!-- Social cards -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <script>
        (function () {
          if (location.hostname !== "mtrecipes.netlify.app") return;
          const h = location.hash || "";
          const isInvite =
            h.includes("invite_token=") ||
            h.includes("recovery_token=") ||
            h.includes("confirmation_token=") ||
            h.includes("access_token=");
          if (isInvite) {
            location.replace("/admin/" + h);
          }
        })();
      </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Schibsted+Grotesk:wght@400;500&display=swap" />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={withBase("/")}>Magnus & Tessern's Recipes</a>
        <nav class="nav">
          <a href={withBase("/")}>Home</a>
          <a href={withBase("/meal-planner")}>Meal Planner</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="container footer">
      <nav class="footer-links">
        <span>Magnus & Tessern's Recipes</span>
        <span aria-hidden="true">·</span>
        <a href={withBase("/about")}>About</a>
        <span aria-hidden="true">·</span>
        <span class="onum">© {new Date().getFullYear()}</span>
      </nav>
    </footer>

    {showPlanner && (
      <PlannerDrawer
        recipes={allRecipes}
        basePath={basePath}
        client:load
      />
    )}

    <script>
      // Reverse morph (Phase 10 T4): arriving at the home map with a snapshot
      // present, fly the cuisine silhouette back onto the restored framing.
      // Module script — runs once, listeners persist across router swaps.
      import { MAP_WIDTH, MAP_HEIGHT } from "../lib/regionGeometry.mjs";

      let stash: { svg: SVGSVGElement; snap: any } | null = null;

      document.addEventListener("astro:before-swap", (e: any) => {
        stash = null;
        if (!("startViewTransition" in document)) return; // fallback = plain crossfade
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const svg = document.querySelector(".cuisine-silhouette svg");
        const raw = sessionStorage.getItem("map:snapshot");
        if (!svg || !raw || !e.newDocument?.querySelector(".worldmap-frame")) return;
        try {
          const clone = svg.cloneNode(true) as SVGSVGElement;
          // Bake computed fills/strokes in: the source page's scoped styles
          // (region-plate classes) don't exist on the destination page
          const src = svg.querySelectorAll("path");
          clone.querySelectorAll("path").forEach((p, i) => {
            const cs = getComputedStyle(src[i]);
            p.style.fill = cs.fill;
            p.style.stroke = cs.stroke;
            p.style.strokeWidth = cs.strokeWidth;
            p.setAttribute("vector-effect", "non-scaling-stroke");
          });
          stash = { svg: clone, snap: JSON.parse(raw) };
        } catch { /* corrupt snapshot: no morph */ }
      });

      document.addEventListener("astro:after-swap", () => {
        if (!stash) return;
        const { svg, snap } = stash;
        stash = null;

        const frame = document.querySelector(".worldmap-frame");
        const vb = (svg.getAttribute("viewBox") ?? "").split(" ").map(Number);
        if (!frame || !snap.projected || vb.length !== 4 || vb.some(Number.isNaN)) return;

        // Base map point → screen: ZoomableGroup transform, then viewBox "meet"
        // fit. Scroll is final here — Astro scrolls before astro:after-swap.
        const rect = frame.getBoundingClientRect();
        const s = Math.min(rect.width / MAP_WIDTH, rect.height / MAP_HEIGHT);
        const ox = rect.left + (rect.width - MAP_WIDTH * s) / 2;
        const oy = rect.top + (rect.height - MAP_HEIGHT * s) / 2;
        const k = snap.zoom;
        const [cx, cy] = snap.projected;
        const toScreen = (x: number, y: number) => [
          ox + s * (MAP_WIDTH / 2 + k * (x - cx)),
          oy + s * (MAP_HEIGHT / 2 + k * (y - cy)),
        ];
        const [x0, y0] = toScreen(vb[0], vb[1]);
        const [x1, y1] = toScreen(vb[0] + vb[2], vb[1] + vb[3]);

        Object.assign(svg.style, {
          position: "fixed",
          left: `${x0}px`,
          top: `${y0}px`,
          width: `${x1 - x0}px`,
          height: `${y1 - y0}px`,
          color: "var(--color-map-active)",
          pointerEvents: "none",
          zIndex: "999",
          viewTransitionName: "cuisine-shape",
        });
        document.body.appendChild(svg);

        // Remove invisibly once the restored map has painted underneath and the
        // ~400ms morph is over; hard fallback in case the island never reports.
        const remove = () => {
          svg.remove();
          window.removeEventListener("worldmap:restored", onRestored);
          clearTimeout(fallback);
        };
        const onRestored = () => setTimeout(remove, 450);
        window.addEventListener("worldmap:restored", onRestored, { once: true });
        const fallback = setTimeout(remove, 1500);
      });
    </script>
  </body>
</html>
